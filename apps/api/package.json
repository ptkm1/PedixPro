{
  "name": "@pedidos/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/run-dev-api.mjs",
    "dev:win": "cmd /c scripts\\dev.cmd",
    "dev:mac": "sh scripts/dev.sh",
    "build": "tsc",
    "typecheck:prisma": "tsc -p tsconfig.prisma.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "prisma": "prisma",
    "smoke:push": "tsx scripts/smoke-push.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@aws-sdk/s3-request-presigner": "^3.1133.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@pedidos/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@xmldom/xmldom": "^0.9.10",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "jsonwebtoken": "^9.0.3",
    "node-forge": "^1.4.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "xml-crypto": "^6.1.2",
    "xpath": "^0.0.34",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.7.0",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@types/xmldom": "^0.1.34",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
