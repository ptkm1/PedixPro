generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SELLER
  SUPERVISOR
  MANAGER
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  PENDING_CREDIT_APPROVAL
}

enum OrderExpeditionStatus {
  IN_PROGRESS
  COMPLETED
}

enum OrderExpeditionEventType {
  START
  SCAN
  MANUAL_INC
  MANUAL_DEC
  COMPLETE
  LABEL_PRINT
  REJECT_UNKNOWN
  REJECT_WRONG
  REJECT_OVER
}

enum CreditPolicy {
  WARN_ONLY
  BLOCK_ORDER
  REQUIRE_APPROVAL
}

/// Como o app do vendedor envia pedidos ao servidor.
enum OrderSyncMode {
  AUTO
  MANUAL
}

/// Cadastro de cliente pelo vendedor: imediato ou aguarda validação no escritório.
enum CustomerRegistrationMode {
  AUTO
  REQUIRE_APPROVAL
}

/// Estado de validação do cadastro do cliente (escritório).
enum CustomerApprovalStatus {
  APPROVED
  PENDING
  REJECTED
}

/// Situação comercial do cliente (ativo / inativo por falta de movimento).
enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum CreditTitleStatus {
  OPEN
  PAID
  CANCELLED
}

/// Provedor bancário de cobrança (boletos dos clientes — não SaaS).
enum BankingProviderKind {
  ITAU
  BB
  SANTANDER
}

enum BankConnectionStatus {
  PENDING_SETUP
  ACTIVE
  ERROR
  DISCONNECTED
}

/// Status interno do recebível (boleto) após mapeamento do provedor.
enum ReceivableStatus {
  PENDING
  PROCESSING
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
  ERROR
}

/// Status da assinatura SaaS da organização.
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  SUSPENDED
}

/// Acesso operacional da organização (pagamento / inadimplência).
enum OrganizationAccessStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

/// Propósito do token de ativação / convite / reset de senha.
enum AccountActivationPurpose {
  OWNER_ACTIVATION
  USER_INVITE
  PASSWORD_RESET
}

/// Quem pode usufruir da promoção neste produto.
enum PromotionScope {
  PRODUCT_GLOBAL
  SELLER
  CUSTOMER
}

/// Como o valor altera o preço de catálogo (tabela/base).
enum PromotionKind {
  PERCENT_OFF
  FIXED_AMOUNT_OFF
  SALE_PRICE
}

/// Desconto aplicado quando o carrinho forma um combo completo (prioridade configurável).
enum ProductComboDiscountKind {
  FIXED_PER_COMPLETE_SET
  PERCENT_OF_SET_SUBTOTAL
}

/// Como o vendedor é comissionado (define de onde vem o % na venda).
enum SellerCommissionType {
  FIXED
  BY_PRODUCT
  BY_CATEGORY
  BY_SUPPLIER
}

/// Escopo de aplicação da meta mensal de faturamento.
enum SellerMonthlyGoalScope {
  SELLER
  TEAM
  ALL
}

enum FiscalDocumentDirection {
  OUTBOUND
  INBOUND
}

enum FiscalInvoiceStatus {
  DRAFT
  TRANSMITTED
  AUTHORIZED
  REJECTED
  CANCELLED
  IMPORTED
}

enum NfeEnvironment {
  HOMOLOGATION
  PRODUCTION
}

enum FiscalTaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

enum FiscalOperationDirection {
  INBOUND
  OUTBOUND
}

enum FiscalManifestationType {
  CIENCIA
  CONFIRMACAO
  DESCONHECIMENTO
  NAO_REALIZADA
}

/// Fila assíncrona de transmissão NF-e (sem Redis).
enum FiscalTransmitJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum CustomerDocumentType {
  CNPJ
  CPF
}

/// Tipo de operação comercial do pedido (digitação de vendas).
enum OrderOperation {
  SALE
}

/// Classificação comercial do produto (cadastro).
enum ProductClassification {
  RESALE
  RAW_MATERIAL
  INTERNAL_USE
  SERVICE
  OTHER
}

enum StockMovementType {
  MANUAL_IN
  MANUAL_OUT
  MANUAL_ADJUST
  ADJUST
  SALE
  SALE_REVERSAL
  INBOUND_INVOICE
  OUTBOUND_INVOICE
}

enum AccountsPayableStatus {
  AUTHORIZED
  PENDING
  PAID
  CANCELLED
}

/// Nível de acesso na matriz de roles (org-scoped).
enum AccessLevel {
  none
  read
  write
}

model Organization {
  id               String             @id @default(cuid())
  name             String
  /// Nome amigável para UI / whitelabel (fallback: `name`).
  displayName      String?
  logoUrl          String?
  /// Cor principal da marca (hex, ex.: #0284c7) para tema futuro no app.
  primaryColor     String?
  /// Identificador opcional para futuro subdomínio (único global quando preenchido).
  slug             String?            @unique
  /// Política quando cliente está bloqueado, com limite estourado ou títulos vencidos.
  creditPolicy     CreditPolicy       @default(WARN_ONLY)
  /// Desconto máximo extra do vendedor (%) quando o produto não define `maxSellerDiscountPercent`.
  defaultMaxSellerDiscountPercent Decimal @default(50) @db.Decimal(5, 2)
  /// AUTO = tenta enviar na hora + auto-flush da fila; MANUAL = sempre fila local até sync manual.
  orderSyncMode    OrderSyncMode      @default(AUTO)
  /// Se false, vendedores só veem clientes atribuídos a eles (sem “carteira” / sellerId null).
  sellerShowUnassignedCustomers Boolean @default(true)
  /// AUTO = cadastro do vendedor já aprovado; REQUIRE_APPROVAL = fica pendente até o escritório validar.
  customerRegistrationMode CustomerRegistrationMode @default(AUTO)
  /// Se true, o vendedor pode editar quantidades de vendas na fila offline antes de sincronizar.
  sellerCanEditQueuedSales Boolean @default(false)
  /// Se true, clientes sem pedido confirmado há 6 meses passam a INACTIVE (reativam ao comprar).
  autoInactivateCustomersAfterMonths Boolean @default(false)
  /// Se true, a org permite gerar Indicadores IA (exige plano com reports_ai).
  aiIndicatorsEnabled Boolean @default(false)
  /// Indicadores do painel home (até 3 chaves ordenadas). Null = defaults do shared.
  homeIndicators   Json?
  /// Legado: layout grade/stack dos indicadores (não usado na home de widgets).
  homeIndicatorsLayout String @default("grid")
  /// TODO futuro: CNPJ do emitente para NF-e real / certificado.
  cnpj             String?
  /// TODO futuro: Inscrição estadual do emitente.
  stateRegistration String?
  /// Roles habilitados na org (JSON array de Role). ADMIN sempre presente.
  enabledRoles     Json               @default("[\"ADMIN\",\"MANAGER\",\"SELLER\"]")
  /// Ciclo de vida comercial (pagamento Asaas). Orgs legadas/demo = ACTIVE.
  accessStatus     OrganizationAccessStatus @default(ACTIVE)
  /// CPF/CNPJ normalizado (apenas dígitos), único quando preenchido.
  document         String?            @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  users            User[]
  sellers          Seller[]
  regions          Region[]
  priceTables      PriceTable[]
  products         Product[]
  productCategories ProductCategory[]
  productPromotions ProductPromotion[]
  productCombos    ProductCombo[]
  sellerCommissionRules SellerCommissionRule[]
  commissionProgressiveTiers CommissionProgressiveTier[]
  sellerMonthlyGoals SellerMonthlyGoal[]
  customers        Customer[]
  orders           Order[]
  paymentConditions PaymentCondition[]
  orderSituations  OrderSituation[]
  customerCreditTitles CustomerCreditTitle[]
  bankConnections      BankConnection[]
  receivables          Receivable[]
  receivableEvents     ReceivableEvent[]
  sellerCustomerVisits SellerCustomerVisit[]
  sellerLiveLocations  SellerLiveLocation[]
  sellerLocationHistory SellerLocationHistory[]
  salesTeams         SalesTeam[]
  suppliers          Supplier[]
  productLots        ProductLot[]
  stockMovements     StockMovement[]
  auditLogs          AuditLog[]
  costCenters        CostCenter[]
  expenseHistories   ExpenseHistory[]
  fixedExpenses      OperationalFixedExpense[]
  accountsPayables   AccountsPayable[]
  rolePermissions    OrganizationRolePermission[]
  profiles           OrganizationProfile[]
  establishments        Establishment[]
  fiscalNcms            FiscalNcm[]
  fiscalOperations      FiscalOperation[]
  fiscalInvoices        FiscalInvoice[]
  fiscalTransmitJobs    FiscalTransmitJob[]
  productStocks         ProductStock[]
  stockExpiryAlerts     StockExpiryAlert[]
  dailyInsights         OrganizationDailyInsight[]
  aiIndicator           OrganizationAiIndicator?
  aiUsageEvents         AiUsageEvent[]
  subscription          OrganizationSubscription?
  checkoutIntents       CheckoutIntent[]
  orderExpeditions      OrderExpedition[]
  purchaseUnits         PurchaseUnit[]
}

/// Última análise de Indicadores IA por organização (1:1).
model OrganizationAiIndicator {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// JSON tipado: { periodLabel, sections[], ... }
  payload            Json
  model              String
  promptTokens       Int          @default(0)
  completionTokens   Int          @default(0)
  totalTokens        Int          @default(0)
  estimatedCostUsd   Decimal?     @db.Decimal(12, 6)
  generatedAt        DateTime     @default(now())
  generatedByUserId  String?

  @@index([organizationId, generatedAt])
}

/// Histórico de uso de tokens de IA (telemetria / futura cobrança).
model AiUsageEvent {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String?
  /// ex.: indicators_generate
  kind             String
  model            String
  promptTokens     Int          @default(0)
  completionTokens Int          @default(0)
  totalTokens      Int          @default(0)
  estimatedCostUsd Decimal?     @db.Decimal(12, 6)
  createdAt        DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, kind, createdAt])
}

/// Resumo matinal baseado em regras (1 por org por dia civil America/Sao_Paulo).
model OrganizationDailyInsight {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Dia civil (YYYY-MM-DD) no fuso America/Sao_Paulo, armazenado como Date.
  date           DateTime     @db.Date
  /// Array de tips: { id, severity, title, reason, href? }.
  tips           Json
  generatedAt    DateTime     @default(now())
  /// Preenchido quando a notificação in-app do dia foi enviada.
  notifiedAt     DateTime?

  @@unique([organizationId, date])
  @@index([organizationId, date])
}

/// Assinatura SaaS (1:1 com Organization). planId alinha com @pedidos/shared PLAN_CATALOG.
model OrganizationSubscription {
  id                     String             @id @default(cuid())
  organizationId         String             @unique
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// start | pro | business
  planId                 String             @default("start")
  status                 SubscriptionStatus @default(TRIAL)
  /// none | asaas | other
  provider               String             @default("none")
  providerCustomerId     String?
  providerSubscriptionId String?
  providerCheckoutId     String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  gracePeriodEndsAt      DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([status, planId])
  @@index([providerCustomerId])
  @@unique([providerSubscriptionId])
  @@unique([providerCheckoutId])
}

/// Intent de checkout (landing → Asaas Checkout Session).
model CheckoutIntent {
  id                     String        @id @default(cuid())
  organizationId         String?
  organization           Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  ownerUserId            String?
  planId                 String
  email                  String
  companyName            String
  adminName              String?
  phone                  String?
  document               String?
  /// Payload serializado sanitizado (sem cartão).
  checkoutPayload        Json
  /// CREATED | CHECKOUT_CREATED | PAYMENT_PROCESSING | COMPLETED | EXPIRED | CANCELED | FAILED
  status                 String        @default("CREATED")
  provider               String        @default("none")
  providerCustomerId     String?
  providerCheckoutId     String?
  providerSubscriptionId String?
  checkoutUrl            String?
  expiresAt              DateTime?
  errorCode              String?
  termsAcceptedAt        DateTime?
  privacyAcceptedAt      DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([email, createdAt])
  @@index([status, createdAt])
  @@index([providerCheckoutId])
  @@index([providerSubscriptionId])
  @@index([organizationId])
}

/// Eventos do provedor de pagamento (idempotência de webhook).
model PaymentProviderEvent {
  id                String    @id @default(cuid())
  provider          String
  providerEventId   String
  eventType         String
  /// received | processed | ignored | failed
  status            String    @default("received")
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?
  errorMessage      String?
  payloadSanitized  Json?

  @@unique([provider, providerEventId])
  @@index([eventType, receivedAt])
}

/// Token de definição/redefinição de senha (ativação, convite ou reset).
/// TTL: ativação/convite ~48h; PASSWORD_RESET ~1h (ver account-activation.ts).
model AccountActivationToken {
  id        String                   @id @default(cuid())
  userId    String
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  purpose   AccountActivationPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                 @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// Matriz de permissões por organização (defaults seedados; ADMIN edita via painel).
model OrganizationRolePermission {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role
  /// Chave estável alinhada a PermissionResource (ex.: stock, orders).
  resource       String
  level          AccessLevel
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, role, resource])
  @@index([organizationId])
}

/// Perfil personalizado da organização (além dos roles de sistema).
model OrganizationProfile {
  id               String                           @id @default(cuid())
  organizationId   String
  organization     Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  /// Matrix/API key, unique per org (e.g. custom_abc123)
  key              String
  enabled          Boolean                          @default(true)
  /// Used as User.role when this profile is assigned; also seeds default permissions
  baseRole         Role                             @default(MANAGER)
  hasSellerProfile Boolean                          @default(false)
  permissions      OrganizationProfilePermission[]
  users            User[]
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, enabled])
}

model OrganizationProfilePermission {
  id        String              @id @default(cuid())
  profileId String
  profile   OrganizationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  resource  String
  level     AccessLevel

  @@unique([profileId, resource])
}

model User {
  id                    String               @id @default(cuid())
  email                 String               @unique
  passwordHash          String
  name                  String
  /// Matrícula funcional (única por organização quando preenchida).
  matricula             String?
  role                  Role
  organizationId        String
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationProfileId String?
  organizationProfile   OrganizationProfile? @relation(fields: [organizationProfileId], references: [id], onDelete: SetNull)
  /// Null até o usuário definir senha (ativação / convite).
  activatedAt           DateTime?
  seller                Seller?
  managedSellers        Seller[]             @relation("SellerManager")
  notifications         Notification[]
  pushDevices           PushDevice[]
  stockMovements        StockMovement[]
  auditLogs             AuditLog[]
  approvedCustomers     Customer[]           @relation("CustomerApprovedBy")
  activationTokens      AccountActivationToken[]
  expeditionsStarted    OrderExpedition[] @relation("ExpeditionStartedBy")
  expeditionsFinished   OrderExpedition[] @relation("ExpeditionFinishedBy")
  expeditionEvents      OrderExpeditionEvent[]
  /// CNPJ/estabelecimento preferido na UI (header). Não altera pedidos antigos.
  preferredEstablishmentId String?
  preferredEstablishment   Establishment? @relation("UserPreferredEstablishment", fields: [preferredEstablishmentId], references: [id], onDelete: SetNull)
  /// null = todos os estabelecimentos; senão lista de IDs permitidos (V1).
  allowedEstablishmentIds  Json?
  cancelledReceivables     Receivable[]      @relation("ReceivableCancelledBy")
  receivableEvents         ReceivableEvent[]
  ordersCreated            Order[]           @relation("OrderCreatedBy")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([organizationId, matricula])
  @@index([organizationProfileId])
  @@index([preferredEstablishmentId])
}

model Seller {
  id                String             @id @default(cuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managerUserId     String?
  manager           User?              @relation("SellerManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  commissionType    SellerCommissionType @default(FIXED)
  commissionPercent Decimal            @db.Decimal(5, 2)
  active            Boolean            @default(true)
  sellerProducts    SellerProduct[]
  productPromotions ProductPromotion[]
  priceTables       PriceTable[]
  commissionRules   SellerCommissionRule[]
  commissionProgressiveTiers CommissionProgressiveTier[]
  monthlyGoals      SellerMonthlyGoal[]
  orders            Order[]
  customers         Customer[]
  sellerCustomerVisits SellerCustomerVisit[]
  liveLocation         SellerLiveLocation?
  locationHistory      SellerLocationHistory[]
  teamId               String?
  team                 SalesTeam?         @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  ledTeam              SalesTeam?         @relation("TeamLeader")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([organizationId, managerUserId])
  @@index([organizationId, teamId])
}

model SalesTeam {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaderSellerId String       @unique
  leaderSeller   Seller       @relation("TeamLeader", fields: [leaderSellerId], references: [id], onDelete: Restrict)
  members        Seller[]     @relation("TeamMembers")
  monthlyGoals   SellerMonthlyGoal[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

/// Última posição reportada pelo app do vendedor (foreground).
model SellerLiveLocation {
  sellerId         String       @id
  seller           Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  latitude         Decimal      @db.Decimal(10, 8)
  longitude        Decimal      @db.Decimal(11, 8)
  accuracyMeters   Float?
  recordedAt       DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, recordedAt])
}

/// Pontos de trajeto (amostrados) para replay no mapa admin.
model SellerLocationHistory {
  id               String       @id @default(cuid())
  sellerId         String
  seller           Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  latitude         Decimal      @db.Decimal(10, 8)
  longitude        Decimal      @db.Decimal(11, 8)
  accuracyMeters   Float?
  recordedAt       DateTime     @default(now())

  @@index([sellerId, recordedAt])
  @@index([organizationId, recordedAt])
}

model Region {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  customers      Customer[]
  priceTables    PriceTable[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
}

model PriceTable {
  id             String           @id @default(cuid())
  name           String
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  validFrom      DateTime?
  validTo        DateTime?
  /// Maior prioridade escolhe entre tabelas igualmente aplicáveis (mesma especificidade).
  priority       Int              @default(0)
  /// Escopo opcional: todos os filtros não-nulos devem coincidir com o contexto da venda.
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sellerId       String?
  seller         Seller?          @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  regionId       String?
  region         Region?          @relation(fields: [regionId], references: [id], onDelete: SetNull)
  items          PriceTableItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

/// Unidade de compra por organização (UN, CX, FD… + códigos personalizados).
model PurchaseUnit {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Código curto estável (ex.: UN, CX, PAL).
  code           String
  name           String
  sortOrder      Int          @default(0)
  /// Unidades padrão do sistema (UN/CX/FD/KG/L).
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, sortOrder])
}

/// Categoria de produto por organização (valores estáveis em `code`, como um enum persistido).
model ProductCategory {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code             String
  name             String
  /// JSON: lista de definições de campos dinâmicos (tipo PIM por categoria).
  attributeSchema  Json?
  /// % de comissão quando vendedores usam modo BY_CATEGORY.
  commissionPercent Decimal?          @db.Decimal(5, 2)
  products         Product[]
  commissionRules  SellerCommissionRule[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, code])
  @@map("product_categories")
}

model Supplier {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code              String
  legalName         String
  cnpj              String
  tradeName         String
  active            Boolean         @default(true)
  stateRegistration String?
  email             String?
  phone             String?
  street            String?
  addressNumber     String?
  complement        String?
  district          String?
  city              String?
  state             String?
  zipCode           String?
  products          Product[]
  fiscalInvoices    FiscalInvoice[]
  fixedExpenses     OperationalFixedExpense[]
  accountsPayables  AccountsPayable[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([organizationId, code])
  @@unique([organizationId, cnpj])
  @@index([organizationId])
}

model Product {
  id               String             @id @default(cuid())
  name             String
  sku              String?
  /// Código de barras / EAN para leitura na venda rápida.
  barcode          String?
  description      String?
  /// URL pública da foto (CDN, bucket, etc.) para catálogo no app do vendedor.
  imageUrl         String?
  /// Em destaque no app de vendas (aparece primeiro e com indicação visual).
  featured         Boolean            @default(false)
  basePrice        Decimal            @db.Decimal(12, 2)
  /// Limite extra do vendedor sobre preço já promocional (null = usa limite da organização).
  maxSellerDiscountPercent Decimal?    @db.Decimal(5, 2)
  /// Piso por unidade após promoções e desconto do vendedor (null = sem piso específico).
  minSaleUnitPrice Decimal?           @db.Decimal(12, 2)
  /// % de comissão quando vendedores usam modo BY_PRODUCT.
  commissionPercent Decimal?           @db.Decimal(5, 2)
  /// JSON: valores dos campos definidos em `category.attributeSchema`.
  attributes       Json               @default("{}")
  /// Quantidade em estoque (unidades vendáveis).
  stockQty         Int                @default(0)
  /// Se ativo, impede venda quando `stockQty` é insuficiente.
  blockSaleWhenOutOfStock Boolean       @default(false)
  /// Linha comercial (ex.: Linha 1).
  productLine      String?
  productClassification ProductClassification?
  /// Código da unidade de compra da org (UN, CX, FD… ou personalizada).
  purchaseUnit     String?
  /// Quantidade por caixa padrão na compra.
  standardPurchaseBoxQty Int?
  grossWeightKg    Decimal?             @db.Decimal(10, 3)
  netWeightKg      Decimal?             @db.Decimal(10, 3)
  stockAddress     String?
  minStockQty      Int                  @default(0)
  maxStockQty      Int?
  costPrice        Decimal?             @db.Decimal(12, 2)
  factoryPrice     Decimal?             @db.Decimal(12, 2)
  maxSalePrice     Decimal?             @db.Decimal(12, 2)
  freightAmount    Decimal?             @db.Decimal(12, 2)
  collectionCommissionPercent Decimal?  @db.Decimal(5, 2)
  maxDailyQtyPerSeller Int?
  maxDailyQtyPerCustomer Int?
  ncm              String?
  ncmException     String?
  /// Origem da mercadoria na NF-e (0–8).
  nfeOrigin        Int?
  fiscalClass      String?
  pisCofinsClassification String?
  cstPis           String?
  ipiPercent       Decimal?             @db.Decimal(5, 2)
  icmsCostPercent  Decimal?           @db.Decimal(5, 2)
  cbsIbsClassification String?
  /// Classificação IBS (Reforma Tributária) — código oficial quando a tabela estiver carregada.
  ibsClassification    String?
  /// CST ICMS do produto (regime normal). Preferência sobre default do NCM da org.
  fiscalCstIcms        String?
  /// CSOSN do produto (Simples Nacional). Preferência sobre default do NCM da org.
  fiscalCsosn          String?
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         ProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId       String?
  supplier         Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  priceTableItems  PriceTableItem[]
  sellerProducts   SellerProduct[]
  promotions       ProductPromotion[]
  comboLines       ProductComboLine[]
  commissionRules  SellerCommissionRule[]
  orderItems       OrderItem[]
  lots             ProductLot[]
  productStock     ProductStock?
  stockMovements   StockMovement[]
  fiscalInvoiceItems FiscalInvoiceItem[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  /// Cadastro fiscal para NF-e (tabela NCM da organização)
  ncmId               String?
  fiscalNcm           FiscalNcm?         @relation(fields: [ncmId], references: [id], onDelete: SetNull)
  fiscalOrigin        Int?
  fiscalGtin          String?
  fiscalUnit          String?
  fiscalCest          String?
  fiscalDescription   String?
  outboundOperationId String?
  outboundOperation   FiscalOperation?   @relation("ProductOutboundOp", fields: [outboundOperationId], references: [id], onDelete: SetNull)

  @@unique([organizationId, barcode])
  @@index([organizationId, supplierId])
  @@index([organizationId, categoryId])
  @@index([organizationId, ncm])
}

/// Catálogo nacional de códigos fiscais (NCM, CFOP, CEST, CST, etc.).
/// Atualizado por importação de tabelas oficiais — não hardcode na UI.
model FiscalCatalogCode {
  id            String    @id @default(cuid())
  /// NCM | CEST | CFOP | CST_ICMS | CSOSN | ORIGEM | CST_PIS | CBS | IBS | CLASS_TRIB | BENEFICIO
  type          String
  code          String
  description   String
  active        Boolean   @default(true)
  validFrom     DateTime?
  validTo       DateTime?
  /// Relacionamentos e filtros (ex.: relatedNcms, contexts, regime).
  metadata      Json      @default("{}")
  /// Identificador da fonte/versão oficial (ex.: TIPI-2024-01, CFOP-AjusteSinief).
  sourceVersion String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([type, code])
  @@index([type, active])
  @@index([type, code])
  @@index([description])
}

/// Lote de produto com validade e saldo próprio.
model ProductLot {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  lotCode        String
  expiresAt      DateTime
  qty            Int            @default(0)
  movements      StockMovement[]
  expiryAlerts   StockExpiryAlert[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([productId, lotCode])
  @@index([organizationId, expiresAt])
  @@index([productId, expiresAt])
}

/// Dedupe de push de validade: um aviso por lote × limiar (30/7/3/0 dias).
model StockExpiryAlert {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lotId          String
  lot            ProductLot   @relation(fields: [lotId], references: [id], onDelete: Cascade)
  /// Limiar cruzado: 30 | 7 | 3 | 0 (vencido).
  thresholdDays  Int
  notifiedAt     DateTime     @default(now())

  @@unique([lotId, thresholdDays])
  @@index([organizationId, notifiedAt])
}

/// Ledger de movimentações de estoque.
model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type           StockMovementType
  qtyDelta       Int
  balanceAfter   Int
  lotId          String?
  lot            ProductLot?       @relation(fields: [lotId], references: [id], onDelete: SetNull)
  lotCode        String?
  expiresAt      DateTime?
  userId         String?
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId        String?
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reason         String?
  createdAt      DateTime          @default(now())

  @@index([organizationId, createdAt])
  @@index([productId, createdAt])
  @@index([orderId])
}

/// Histórico rastreável de alterações sensíveis.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userMatricula  String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}

model ProductPromotion {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  scope          PromotionScope
  sellerId       String?
  seller         Seller?         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind           PromotionKind
  /// PERCENT_OFF: 0–100 | FIXED_AMOUNT_OFF: R$ por unidade | SALE_PRICE: preço final por unidade.
  value          Decimal         @db.Decimal(12, 2)
  /// Se definido, a promo só concorre quando `quantity >= minQuantity` na linha.
  minQuantity    Int?
  label          String?
  active         Boolean         @default(true)
  validFrom      DateTime?
  validTo        DateTime?
  priority       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, productId])
  @@map("product_promotions")
}

model ProductCombo {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  label          String?
  active         Boolean                  @default(true)
  validFrom      DateTime?
  validTo        DateTime?
  priority       Int                      @default(0)
  kind           ProductComboDiscountKind
  /// FIXED_PER_COMPLETE_SET: R$ por cada conjunto completo | PERCENT_OF_SET_SUBTOTAL: % sobre subtotal do conjunto.
  value          Decimal                  @db.Decimal(12, 2)
  lines          ProductComboLine[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([organizationId])
}

model ProductComboLine {
  id        String       @id @default(cuid())
  comboId   String
  combo     ProductCombo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([comboId, productId])
}

model SellerCommissionRule {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sellerId           String
  seller             Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId         String?
  category           ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  commissionPercent  Decimal          @db.Decimal(5, 2)
  priority           Int              @default(0)
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([organizationId, sellerId])
}

/// Faixa de comissão progressiva pelo faturamento confirmado no mês (MTD).
model CommissionProgressiveTier {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Null = faixa global da organização (vale para todos os vendedores sem faixas próprias).
  sellerId           String?
  seller             Seller?      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  /// Vendas confirmadas no mês (R$) desde as quais esta faixa se aplica (inclusive).
  thresholdAmount    Decimal      @db.Decimal(14, 2)
  commissionPercent  Decimal      @db.Decimal(5, 2)
  label              String?
  priority           Int          @default(0)
  active             Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId, sellerId])
}

/// Meta de faturamento mensal (vendedor, equipe ou todos os vendedores).
model SellerMonthlyGoal {
  id               String                 @id @default(cuid())
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scope            SellerMonthlyGoalScope @default(SELLER)
  /// Chave estável para upsert: SELLER:<id> | TEAM:<id> | ALL
  scopeKey         String
  /// Obrigatório quando scope = SELLER.
  sellerId         String?
  seller           Seller?                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  /// Obrigatório quando scope = TEAM.
  teamId           String?
  team             SalesTeam?             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  year             Int
  month            Int
  title            String                 @default("Meta do mês")
  targetAmount     Decimal                @db.Decimal(14, 2)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([organizationId, scopeKey, year, month])
  @@index([organizationId, year, month])
  @@index([organizationId, sellerId])
  @@index([organizationId, teamId])
}

model PriceTableItem {
  id           String     @id @default(cuid())
  priceTableId String
  priceTable   PriceTable @relation(fields: [priceTableId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  price        Decimal    @db.Decimal(12, 2)

  @@unique([priceTableId, productId])
}

model SellerProduct {
  id        String   @id @default(cuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sellerId, productId])
}

model Customer {
  id             String             @id @default(cuid())
  /// Código interno numérico sequencial por organização (exibido no app/web).
  code           Int?
  name           String
  email          String?
  phone          String?
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sellerId       String?
  seller         Seller?            @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  regionId       String?
  region         Region?            @relation(fields: [regionId], references: [id], onDelete: SetNull)
  /// Limite de crédito (saldo em aberto máximo). Null = sem limite configurado.
  creditLimit    Decimal?           @db.Decimal(14, 2)
  /// Bloqueio manual — não permite novo pedido confirmado (conforme política da organização).
  creditBlocked  Boolean            @default(false)
  promotions     ProductPromotion[]
  priceTables    PriceTable[]
  orders         Order[]
  creditTitles   CustomerCreditTitle[]
  receivables    Receivable[]
  sellerCustomerVisits SellerCustomerVisit[]
  /// Coordenadas para mapa / rota (opcional; configuradas pelo admin).
  latitude       Decimal?           @db.Decimal(10, 8)
  longitude      Decimal?           @db.Decimal(11, 8)
  addressNote    String?
  documentType   CustomerDocumentType?
  cnpj           String?
  cpf            String?
  legalName      String?
  tradeName      String?
  cep            String?
  street         String?
  number         String?
  neighborhood   String?
  state          String?
  city           String?
  cityIbgeCode   String?
  stateRegistration String?
  buyerName      String?
  notes          String?
  /// Validação do cadastro (default APPROVED para clientes já existentes / criados pelo admin).
  approvalStatus CustomerApprovalStatus @default(APPROVED)
  approvalNote   String?
  approvedAt     DateTime?
  approvedByUserId String?
  approvedBy     User?              @relation("CustomerApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  rejectedAt     DateTime?
  rejectionReason String?
  /// Situação comercial: ACTIVE / INACTIVE (inativação automática opcional por org).
  status         CustomerStatus     @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, approvalStatus])
  @@index([organizationId, status])

  @@unique([organizationId, cnpj])
  @@unique([organizationId, cpf])
  @@unique([organizationId, code])
  @@index([organizationId, state, city])
}

model CustomerCreditTitle {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reference        String?
  amount           Decimal           @db.Decimal(14, 2)
  paidAmount       Decimal           @default(0) @db.Decimal(14, 2)
  issueDate        DateTime          @default(now())
  dueDate          DateTime
  status           CreditTitleStatus @default(OPEN)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([organizationId, customerId])
}

/// Conexão da organização com API de cobrança bancária (boletos de clientes).
model BankConnection {
  id                       String               @id @default(cuid())
  organizationId           String
  organization             Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider                 BankingProviderKind
  status                   BankConnectionStatus @default(PENDING_SETUP)
  /// Metadados não-secretos: agência, conta, carteira, convênio, workspaceId, ambiente.
  metadata                 Json?
  /// Segredos criptografados (AES-GCM). Preferir refs em env via credentialsEnvPrefix.
  credentialsEncrypted     String?              @db.Text
  /// Prefixo de variáveis de ambiente com secrets (nunca exposto ao frontend).
  credentialsEnvPrefix     String?
  webhookSecretEncrypted   String?              @db.Text
  lastSyncAt               DateTime?
  lastError                String?
  /// Reserva futura: importação CNAB (não implementado).
  cnabEnabled              Boolean              @default(false)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  receivables              Receivable[]

  @@unique([organizationId, provider])
  @@index([organizationId, status])
}

/// Conta a receber (boleto) sincronizada com o banco — distinta da assinatura SaaS Asaas.
model Receivable {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId          String?
  order            Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  bankConnectionId String
  bankConnection   BankConnection    @relation(fields: [bankConnectionId], references: [id], onDelete: Restrict)
  externalId       String?
  nossoNumero      String?
  digitableLine    String?
  barcode          String?
  amount           Decimal           @db.Decimal(14, 2)
  paidAmount       Decimal           @default(0) @db.Decimal(14, 2)
  dueDate          DateTime
  paidAt           DateTime?
  status           ReceivableStatus  @default(PENDING)
  externalStatus   String?
  lastSyncedAt     DateTime?
  metadata         Json?
  /// Parcela 1-based (null = boleto único legado).
  installmentIndex Int?
  installmentTotal Int?
  pdfUrl           String?
  pdfStoredAt      DateTime?
  instructions     String?
  interestPercent  Decimal?          @db.Decimal(5, 2)
  finePercent      Decimal?          @db.Decimal(5, 2)
  discountAmount   Decimal?          @db.Decimal(14, 2)
  discountUntil    DateTime?
  cancelledAt      DateTime?
  cancelledByUserId String?
  cancelledByUser  User?             @relation("ReceivableCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  cancelReason     String?
  events           ReceivableEvent[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([bankConnectionId, externalId])
  @@index([organizationId, customerId, status])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, orderId])
  @@index([organizationId, orderId, installmentIndex])
  @@index([bankConnectionId, nossoNumero])
}

/// Histórico imutável de operações sobre boleto (emissão, edição, cancelamento…).
model ReceivableEvent {
  id             String     @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receivableId   String
  receivable     Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  actorUserId    String?
  actorUser      User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// EMIT | UPDATE | CANCEL | SYNC | PDF_VIEW | PDF_DOWNLOAD | REISSUE | STATUS
  action         String
  message        String
  metadata       Json?
  createdAt      DateTime   @default(now())

  @@index([receivableId, createdAt])
  @@index([organizationId, createdAt])
}

/// Eventos de webhook bancário (idempotência + auditoria). Separado do Asaas SaaS.
model BankingWebhookEvent {
  id               String              @id @default(cuid())
  provider         BankingProviderKind
  providerEventId  String
  eventType        String
  /// received | processed | ignored | failed
  status           String              @default("received")
  organizationId   String?
  bankConnectionId String?
  receivableId     String?
  receivedAt       DateTime            @default(now())
  processedAt      DateTime?
  errorMessage     String?
  payloadSanitized Json?

  @@unique([provider, providerEventId])
  @@index([provider, receivedAt])
  @@index([organizationId, receivedAt])
}

model SellerCustomerVisit {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sellerId         String
  seller           Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  checkedInAt      DateTime     @default(now())
  checkedOutAt     DateTime?
  checkInLat       Decimal?     @db.Decimal(10, 8)
  checkInLng       Decimal?     @db.Decimal(11, 8)
  checkOutLat      Decimal?     @db.Decimal(10, 8)
  checkOutLng      Decimal?     @db.Decimal(11, 8)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([sellerId, checkedInAt])
  @@index([organizationId, checkedInAt])
}

/// Condição de pagamento cadastrada por organização (ex.: À vista, BL 7 dias).
model PaymentCondition {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Código curto exibido na lista (ex.: "1", "8").
  code           String
  name           String
  /// Prazo principal em dias (0 = à vista).
  days           Int          @default(0)
  /// Dias de cada parcela (ex.: [30,60,90]). Vazio = parcela única usando `days`.
  installmentDays Int[]       @default([])
  active         Boolean      @default(true)
  sortOrder      Int          @default(0)
  orders         Order[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, active, sortOrder])
}

/// Etapa do fluxo do pedido (único campo visível). Inclui etapas de sistema
/// (Rascunho, Crédito, Entregue, Cancelado) e etapas da org (Aberto, Enviado…).
/// Order.status é derivado desta etapa (estoque/crédito/NF) e não aparece na UI.
model OrderSituation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Código estável por org (ex.: DRAFT, SENT, DELIVERED).
  code           String
  name           String
  sortOrder      Int          @default(0)
  active         Boolean      @default(true)
  /// Etapas padrão do sistema (não excluir; nome pode ser editado).
  isSystem       Boolean      @default(false)
  /// Etapa de cancelamento: sincroniza Order.status = CANCELLED e estorna estoque.
  mapsToCancel   Boolean      @default(false)
  orders         Order[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, active, sortOrder])
}

model Order {
  id             String       @id @default(cuid())
  /// Derivado da etapa (`situation`). Não exibir na UI — use `situation`.
  status         OrderStatus  @default(DRAFT)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Estabelecimento (CNPJ) emissor — snapshot no momento da venda.
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  /// Null = venda direta (sem comissão / fora de metas individuais).
  sellerId       String?
  seller         Seller?      @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  /// Quem lançou o pedido (ADM/Gestor/Vendedor). Independente de `sellerId`.
  createdByUserId String?
  createdByUser   User?       @relation("OrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentConditionId String?
  paymentCondition   PaymentCondition? @relation(fields: [paymentConditionId], references: [id], onDelete: SetNull)
  /// Etapa única do pedido (sistema + org). Obrigatória.
  situationId    String
  situation      OrderSituation @relation(fields: [situationId], references: [id], onDelete: Restrict)
  operation      OrderOperation @default(SALE)
  totalAmount    Decimal      @db.Decimal(14, 2)
  /// Total descontado por combos aplicados sobre as linhas (já refletido em `totalAmount`).
  comboDiscountTotal Decimal   @default(0) @db.Decimal(14, 2)
  notes          String?
  /// UUID gerado no cliente para vendas offline — replay idempotente (sem duplicar pedido).
  clientMutationId String? @unique
  /// Motivos registrados quando o pedido ficou aguardando aprovação de crédito.
  creditHoldReasons Json?
  /// TODO futuro: número sequencial por org para filtro "Número entre" (hoje id=cuid). Pode ser removido ou implementado depois.
  orderNumber    Int?
  /// TODO futuro: flag de orçamento vs pedido real. Reservado; UI não filtra neste ciclo.
  isQuote        Boolean      @default(false)
  /// TODO futuro: "Representada" (multi-empresa). Reservado; UI não filtra neste ciclo.
  representada   String?
  items          OrderItem[]
  stockMovements StockMovement[]
  fiscalInvoices FiscalInvoice[]
  expedition     OrderExpedition?
  receivables    Receivable[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, orderNumber])
  @@index([organizationId, createdAt])
  @@index([organizationId, sellerId])
  @@index([organizationId, createdByUserId])
  @@index([organizationId, paymentConditionId])
  @@index([organizationId, situationId])
  @@index([organizationId, establishmentId])
  @@index([establishmentId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  productName String
  commissionPercent Decimal? @db.Decimal(5, 2)
  commissionAmount  Decimal? @db.Decimal(14, 2)
  expeditionItems OrderExpeditionItem[]
  createdAt   DateTime @default(now())
}

/// Conferência física de um pedido (expedição). Estoque já foi baixado na confirmação.
model OrderExpedition {
  id               String                 @id @default(cuid())
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderId          String                 @unique
  order            Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status           OrderExpeditionStatus  @default(IN_PROGRESS)
  startedAt        DateTime               @default(now())
  startedByUserId  String
  startedBy        User                   @relation("ExpeditionStartedBy", fields: [startedByUserId], references: [id], onDelete: Restrict)
  finishedAt       DateTime?
  finishedByUserId String?
  finishedBy       User?                  @relation("ExpeditionFinishedBy", fields: [finishedByUserId], references: [id], onDelete: SetNull)
  volumeQty        Int                    @default(1)
  items            OrderExpeditionItem[]
  events           OrderExpeditionEvent[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, startedAt])
}

model OrderExpeditionItem {
  id            String           @id @default(cuid())
  expeditionId  String
  expedition    OrderExpedition  @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  orderItemId   String
  orderItem     OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productId     String
  requestedQty  Int
  checkedQty    Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([expeditionId, orderItemId])
  @@index([expeditionId])
}

model OrderExpeditionEvent {
  id           String                    @id @default(cuid())
  expeditionId String
  expedition   OrderExpedition           @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  userId       String
  user         User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  type         OrderExpeditionEventType
  orderItemId  String?
  productId    String?
  barcode      String?
  qtyDelta     Int                       @default(0)
  reason       String?
  createdAt    DateTime                  @default(now())

  @@index([expeditionId, createdAt])
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  /// SALE_CONFIRMED | CREDIT_PENDING | GOAL_UPDATED | CREDIT_RESOLVED | CUSTOMER_PENDING_APPROVAL | …
  type      String   @default("GENERIC")
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

/// Token Expo (mobile) ou subscription Web Push (browser) por utilizador.
model PushDevice {
  id                   String       @id @default(cuid())
  userId               String
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform             PushPlatform
  expoPushToken        String?
  webPushEndpoint      String?
  webPushSubscription  Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([expoPushToken])
  @@unique([webPushEndpoint])
  @@index([userId])
}

/// Centro de custo (lookup para lançamentos / despesas fixas).
model CostCenter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  active         Boolean      @default(true)
  fixedExpenses  OperationalFixedExpense[]
  accountsPayables AccountsPayable[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// Histórico contábil / natureza da despesa (ex.: IMPOSTO).
model ExpenseHistory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  description    String
  active         Boolean      @default(true)
  fixedExpenses  OperationalFixedExpense[]
  accountsPayables AccountsPayable[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// Template de despesa operacional fixa (recorrente) para uso futuro em relatórios.
model OperationalFixedExpense {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  supplierId     String?
  supplier       Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  costCenterId   String?
  costCenter     CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  historyId      String?
  history        ExpenseHistory? @relation(fields: [historyId], references: [id], onDelete: SetNull)
  amount         Decimal      @db.Decimal(14, 2)
  /// Dia do mês do vencimento recorrente (1–28).
  dayOfMonth     Int
  active         Boolean      @default(true)
  notes          String?
  competenceLabel String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, active])
}

/// Lançamento de contas a pagar (despesa operacional).
model AccountsPayable {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Número / referência do documento.
  docNumber      String
  supplierId     String
  supplier       Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  issueDate      DateTime
  dueDate        DateTime
  /// Competência (usar 1º dia do mês).
  competence     DateTime
  historyId      String?
  history        ExpenseHistory?       @relation(fields: [historyId], references: [id], onDelete: SetNull)
  costCenterId   String?
  costCenter     CostCenter?           @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  amount         Decimal               @db.Decimal(14, 2)
  notes          String?
  status         AccountsPayableStatus @default(AUTHORIZED)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([organizationId, dueDate])
  @@index([organizationId, status])
  @@index([organizationId, supplierId])
}

/// Estabelecimento (CNPJ/filial) dentro da Organization. Estoque continua por org;
/// emissão NF-e e numeração são por estabelecimento.
model Establishment {
  id                        String          @id @default(cuid())
  organizationId            String
  organization              Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalName                 String
  tradeName                 String?
  cnpj                      String?
  stateRegistration         String?
  municipalRegistration     String?
  taxRegime                 FiscalTaxRegime @default(SIMPLES_NACIONAL)
  uf                        String?
  cityIbge                  String?
  street                    String?
  addressNumber             String?
  complement                String?
  district                  String?
  city                      String?
  zipCode                   String?
  nfeEnvironment            NfeEnvironment  @default(HOMOLOGATION)
  nfeSeries                 Int             @default(1)
  nfeLastNumber             Int             @default(0)
  /// Série NFC-e (modelo 65) — arquitetura; emissão ainda não implementada.
  nfceSeries                Int?
  nfceLastNumber            Int?
  /// Contingência SVC automática (fallback se a SEFAZ da UF estiver indisponível).
  /// true = forçar emissão já no SVC, mesmo com a autorizadora no ar.
  contingencyEnabled        Boolean         @default(false)
  certificatePfxEncrypted   Bytes?
  certificatePasswordEncrypted String?
  certificateExpiresAt      DateTime?
  certificateCnpj           String?
  /// Último limiar de alerta de validade notificado (60|30|15|7|0). Null = nenhum.
  certificateLastAlertThreshold Int?
  autoStockOnInboundInvoice Boolean         @default(false)
  /// Imagem da logo exibida no DANFE (PNG/JPEG/WebP).
  danfeLogoBytes            Bytes?
  danfeLogoMimeType         String?
  isPrimary                 Boolean         @default(false)
  active                    Boolean         @default(true)
  orders                    Order[]
  fiscalInvoices            FiscalInvoice[]
  preferredByUsers          User[]          @relation("UserPreferredEstablishment")
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  @@unique([organizationId, cnpj])
  @@index([organizationId, active])
  @@index([organizationId, isPrimary])
}

model FiscalNcm {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code             String
  description      String
  cest             String?
  defaultCstIcms   String?
  defaultCsosn     String?
  icmsRate         Decimal?     @db.Decimal(5, 2)
  pisRate          Decimal?     @db.Decimal(5, 2)
  cofinsRate       Decimal?     @db.Decimal(5, 2)
  /// Alíquota FCP (%) quando aplicável; 0/null = sem FCP no XML.
  fcpRate          Decimal?     @db.Decimal(5, 2)
  active           Boolean      @default(true)
  products         Product[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, code])
}

model FiscalOperation {
  id               String                   @id @default(cuid())
  organizationId   String
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  direction        FiscalOperationDirection
  cfop             String
  description      String
  nature           String?
  defaultCstIcms   String?
  defaultCsosn     String?
  movesStock       Boolean                  @default(false)
  active           Boolean                  @default(true)
  productsOutbound Product[]                @relation("ProductOutboundOp")
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([organizationId, direction, cfop])
}

model FiscalInvoice {
  id               String                  @id @default(cuid())
  organizationId   String
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Emitente da nota (mesmo do pedido na saída).
  establishmentId  String?
  establishment    Establishment?          @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  direction        FiscalDocumentDirection
  status           FiscalInvoiceStatus     @default(DRAFT)
  /// 55 = NF-e; 65 = NFC-e (arquitetura — emissão 65 ainda não implementada).
  documentModel    Int                     @default(55)
  /// Tipo de emissão SEFAZ (1=normal, 6=SVC-AN, 7=SVC-RS).
  tpEmis           String                  @default("1")
  contingencyJustification String?
  /// Modalidade frete NF-e (0–9). Default 9 = sem frete.
  modFrete         String                  @default("9")
  freightAmount    Decimal?                @db.Decimal(14, 2)
  volumeQty        Decimal?                @db.Decimal(14, 4)
  grossWeightKg    Decimal?                @db.Decimal(14, 3)
  netWeightKg      Decimal?                @db.Decimal(14, 3)
  orderId          String?
  order            Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  supplierId       String?
  supplier         Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  customerId       String?
  number           Int?
  series           Int?
  accessKey        String?                 @unique
  totalAmount      Decimal                 @db.Decimal(14, 2)
  issuedAt         DateTime?
  xmlSigned        String?                 @db.Text
  xmlAuthorized    String?                 @db.Text
  protocol         String?
  rejectionReason  String?
  issuerSnapshot   Json?
  recipientSnapshot Json?
  stockApplied     Boolean                 @default(false)
  manifestationType FiscalManifestationType?
  items            FiscalInvoiceItem[]
  events           FiscalInvoiceEvent[]
  transmitJobs     FiscalTransmitJob[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([organizationId, direction, status])
  @@index([organizationId, orderId])
  @@index([organizationId, establishmentId])
  @@index([establishmentId])
}

/// Job de transmissão/poll assíncrono da NF-e.
model FiscalTransmitJob {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        FiscalInvoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  status         FiscalTransmitJobStatus @default(PENDING)
  attempts       Int                     @default(0)
  nextRunAt      DateTime                @default(now())
  lastError      String?
  /// Recibo SEFAZ (nRec) quando cStat 103 — para poll posterior.
  sefazReceipt   String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([status, nextRunAt])
  @@index([organizationId, status])
  @@index([invoiceId])
}

model FiscalInvoiceItem {
  id               String        @id @default(cuid())
  fiscalInvoiceId  String
  fiscalInvoice    FiscalInvoice @relation(fields: [fiscalInvoiceId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  lineNumber       Int
  description      String
  ncm              String?
  cfop             String?
  unit             String?
  quantity         Decimal       @db.Decimal(14, 4)
  unitPrice        Decimal       @db.Decimal(12, 2)
  totalPrice       Decimal       @db.Decimal(14, 2)
  supplierProductCode String?
  taxSnapshot      Json?
  createdAt        DateTime      @default(now())
}

model FiscalInvoiceEvent {
  id               String        @id @default(cuid())
  fiscalInvoiceId  String
  fiscalInvoice    FiscalInvoice @relation(fields: [fiscalInvoiceId], references: [id], onDelete: Cascade)
  eventType        String
  requestPayload   String?       @db.Text
  responsePayload  String?       @db.Text
  success          Boolean       @default(false)
  createdAt        DateTime      @default(now())
}

model ProductStock {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId        String       @unique
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityOnHand   Decimal      @default(0) @db.Decimal(14, 4)
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, productId])
}
