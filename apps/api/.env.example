DATABASE_URL=postgresql://pedidos:pedidos@localhost:5432/pedidos
# Produção Neon: DATABASE_URL = pooled (-pooler) para a API.
# DIRECT_URL = host direto (sem -pooler) para prisma migrate. Também aceita DATABASE_URL_UNPOOLED.
# Se DIRECT_URL estiver errado (ainda com -pooler), o Prisma CLI remove -pooler sozinho.
# DIRECT_URL=
# DATABASE_URL_UNPOOLED=
#
# Neon Free (esticar CU-hours): use host -pooler; a API fecha idle em ~5s (PG_IDLE_TIMEOUT_MS).
# Evite FISCAL_TRANSMIT_CRON=1 com poll de 1 min — acorda o compute o mês inteiro.
# Prefira job externo (/jobs/fiscal-transmit) a cada 15–60 min, ou FISCAL_TRANSMIT_CRON_MS=600000.
# PG_POOL_MAX=5
# PG_IDLE_TIMEOUT_MS=5000
# PG_CONNECT_TIMEOUT_MS=15000

JWT_SECRET=gere-uma-string-longa-aleatoria-minimo-16-chars
JWT_REFRESH_SECRET=outra-string-longa-diferente-da-anterior

API_PORT=4000
API_HOST=0.0.0.0

# Google Routes API (rota por estrada no servidor — não commitar chave real)
# Ative "Routes API" no Google Cloud. Pode ser a mesma chave do Maps ou uma só de backend.
# GOOGLE_MAPS_SERVER_API_KEY=

# Interruptor mestre: false = nunca chama routes.googleapis.com (seguro em dev)
GOOGLE_ROUTES_ENABLED=false
# Máximo de pedidos Routes por organização por dia UTC (0 = bloqueado mesmo com ENABLED=true)
GOOGLE_ROUTES_DAILY_MAX_PER_ORG=0
# Teto global opcional por dia (0 = sem limite global extra)
GOOGLE_ROUTES_DAILY_MAX_GLOBAL=0
# Exemplo produção (quando tiver orçamento):
# GOOGLE_ROUTES_ENABLED=true
# GOOGLE_ROUTES_DAILY_MAX_PER_ORG=100
# GOOGLE_ROUTES_DAILY_MAX_GLOBAL=500

# --- E-mail transacional (opcional) ---
# Recomendado: Resend (https://resend.com) — API simples, bom free tier.
# Basta definir RESEND_API_KEY + EMAIL_FROM (domínio verificado no painel).
#
# Alternativa: SendGrid — use EMAIL_PROVIDER=sendgrid e SENDGRID_API_KEY.
#
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# SENDGRID_API_KEY=
# EMAIL_FROM=PedixPro <noreply@seudominio.com>
#
# Links de ativação / reset usam o painel (TTL: ativação 48h, reset 1h).
# WEB_APP_ORIGIN=https://app.pedixpro.com.br
# WEB_PUBLIC_URL=https://app.pedixpro.com.br
# SITE_PUBLIC_URL=https://pedixpro.com.br
# Aliases aceitos pela contratação Asaas:
# PEDIXPRO_APP_URL=https://app.pedixpro.com.br
# PEDIXPRO_LANDING_URL=https://pedixpro.com.br

# --- Asaas (checkout recorrente / webhooks) ---
# Sandbox: https://sandbox.asaas.com — produção: https://www.asaas.com
# Gateway: auto (Asaas se houver API key; senão trial local) | asaas | fake
# fake só funciona fora de produção (abre checkout sem ASAAS_API_KEY).
# PAYMENT_GATEWAY=auto
# ASAAS_API_KEY=
# ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# ASAAS_WEBHOOK_TOKEN=
# ASAAS_ENVIRONMENT=sandbox
# ASAAS_CHECKOUT_URL_PREFIX=https://sandbox.asaas.com/checkoutSession/show
# SUBSCRIPTION_GRACE_PERIOD_DAYS=7

# --- Web Push (VAPID) — grátis; gerar com: npx web-push generate-vapid-keys ---
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:admin@seudominio.com

# --- Jobs internos (cron) ---
# Protege POST /api/v1/jobs/stock-expiry (Authorization: Bearer … ou x-cron-secret).
# CRON_SECRET=gere-uma-string-longa-aleatoria
# Agenda diária na API (08:00): STOCK_EXPIRY_CRON=1
# STOCK_EXPIRY_CRON=0
# STOCK_EXPIRY_CRON_TZ=America/Sao_Paulo
# Fila de transmissão NF-e (poll; padrão 10 min com FISCAL_TRANSMIT_CRON=1):
# No Neon Free, deixe desligado e use POST /jobs/fiscal-transmit via cron externo.
# FISCAL_TRANSMIT_CRON=0
# FISCAL_TRANSMIT_CRON_MS=600000

# --- Consulta CNPJ (Receita Federal via proxy) ---
# Provedor: brasilapi (gratuito, padrão) ou serpro (API oficial contratada).
# CNPJ_PROVIDER=brasilapi
#
# Serpro — após contratar em https://apicenter.estaleiro.serpro.gov.br/documentacao/consulta-cnpj/
# SERPRO_CONSUMER_KEY=
# SERPRO_CONSUMER_SECRET=

# Chave para criptografar certificado A1 em repouso (mín. 16 caracteres)
# FISCAL_ENCRYPTION_KEY=gere-uma-string-longa-aleatoria-minimo-16-chars

# --- Conciliação bancária (boletos dos clientes — NÃO Asaas SaaS) ---
# Ver docs/banking-boletos.md
# BANKING_ENCRYPTION_KEY=  # opcional; fallback FISCAL_ENCRYPTION_KEY
# BANKING_ENVIRONMENT=sandbox
# BANKING_ITAU_WEBHOOK_TOKEN=
# BANKING_BB_WEBHOOK_TOKEN=
# BANKING_SANTANDER_WEBHOOK_TOKEN=
# Prefixo por org (exemplo Santander):
# BANKING_SANTANDER_ACME_CLIENT_ID=
# BANKING_SANTANDER_ACME_CLIENT_SECRET=
# BANKING_SANTANDER_ACME_WORKSPACE_ID=
# BANKING_SANTANDER_ACME_COVENANT_CODE=
# BANKING_SANTANDER_ACME_WEBHOOK_SECRET=
# BB também: ..._APP_KEY=
# Itaú (quando homologado): ..._CERT_PEM= ..._KEY_PEM=

# --- Indicadores IA (OpenAI) ---
# Kill switch: false = nunca chama a OpenAI (mesmo com chave).
AI_INDICATORS_ENABLED=false
# Chave da API OpenAI (platform.openai.com) — NÃO use sessão do ChatGPT Plus.
# OPENAI_API_KEY=sk-...
# Modelo (padrão gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# --- Fotos de produto (Cloudflare R2 — S3-compatível, egress $0) ---
# 1) Crie um bucket R2 no Cloudflare Dashboard → R2.
# 2) Em Manage R2 API Tokens, crie token com Object Read & Write no bucket.
# 3) Em Settings do bucket → Public access: R2.dev subdomain OU Custom Domain
#    (ex.: cdn.pedixpro.com.br). R2_PUBLIC_BASE_URL = essa URL sem barra final.
# 4) CORS do bucket (Settings → CORS) — necessário para PUT direto do painel:
#    AllowedOrigins: https://app.pedixpro.com.br, http://localhost:5173
#    AllowedMethods: PUT, GET, HEAD
#    AllowedHeaders: Content-Type
#    MaxAgeSeconds: 3600
# Free tier típico: 10 GB storage + ops generosas; sem cobrança de egress.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=pedixpro-product-images
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# (ou https://cdn.pedixpro.com.br)
# Quotas por organização (custo-benefício; 0 = desliga aquele teto)
# AI_INDICATORS_COOLDOWN_MINUTES=15
# AI_INDICATORS_MAX_PER_HOUR=3
# AI_INDICATORS_MAX_PER_DAY=5
# AI_INDICATORS_MAX_PER_MONTH=30
# AI_INDICATORS_MAX_COMPLETION_TOKENS=1200
