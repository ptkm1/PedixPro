{
  "expo": {
    "name": "PedixPro",
    "slug": "pedidos-mobile",
    "version": "1.0.6",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "pedixpro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#02445C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pedixpro.app",
      "buildNumber": "19",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#02445C"
      },
      "package": "com.pedixpro.app",
      "versionCode": 18,
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": false
    },
    "androidNavigationBar": {
      "enforceContrast": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "extraProguardRules": "-allowaccessmodification\n-keepattributes SourceFile,LineNumberTable\n-keepattributes *Annotation*\n-keep class com.facebook.react.** { *; }\n-keep class com.facebook.hermes.** { *; }\n-keep class com.swmansion.** { *; }\n-keep class expo.modules.** { *; }\n-dontwarn com.facebook.react.**\n-dontwarn com.facebook.hermes.**"
          }
        }
      ],
      "./plugins/withPlayConsoleAndroidFixes.js",
      "expo-document-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos a câmara só para ler códigos de barras ao registar vendas.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O PedixPro usa a sua localização em segundo plano para o gestor acompanhar a rota da equipa (uso profissional).",
          "locationWhenInUsePermission": "O PedixPro usa a sua localização para o mapa de rota, check-in de visitas e rastreio.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-task-manager",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#02445C",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "533c4fc8-7849-4180-bdb5-5d27fd5be149"
      }
    }
  }
}
